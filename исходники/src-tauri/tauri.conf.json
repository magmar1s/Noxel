{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noxel",
  "identifier": "app.noxel.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Noxel",
        "width": 1180,
        "height": 760,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "magmar1s",
    "copyright": "Copyright 2026 magmar1s and Noxel contributors",
    "shortDescription": "Лаунчер Minecraft",
    "longDescription": "Лаунчер Minecraft Noxel: у каждой версии свои моды."
  }
}
