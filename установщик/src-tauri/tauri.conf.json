{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noxel Setup",
  "identifier": "app.noxel.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Установка Noxel",
        "width": 760,
        "height": 560,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "Noxel",
    "copyright": "© 2026 Noxel",
    "shortDescription": "Установщик лаунчера Noxel",
    "longDescription": "Установщик лаунчера Noxel Noxel: у каждой версии свои моды."
  }
}